# syntax=docker/dockerfile:1.7
# Fixture-only native clients, including keygen for disposable identities.
FROM python@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7
ADD --checksum=sha256:cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10 https://github.com/FiloSottile/age/releases/download/v1.3.2/age-v1.3.2-linux-amd64.tar.gz /tmp/age.tar.gz
ADD --checksum=sha256:b00f00b3266c3764413afe599d3ec316f6f43b3e0ea8a0bc1d186d2133e46df7 https://github.com/rclone/rclone/releases/download/v1.76.0/rclone-v1.76.0-linux-amd64.zip /tmp/rclone.zip
RUN python3 - <<'PY'
import os, tarfile, zipfile
os.mkdir('/tools', 0o755)
with tarfile.open('/tmp/age.tar.gz') as archive:
    for name in ['age', 'age-keygen']:
        member = archive.getmember('age/' + name)
        assert member.isreg()
        with archive.extractfile(member) as source, open('/tools/' + name, 'xb') as target:
            target.write(source.read())
with zipfile.ZipFile('/tmp/rclone.zip') as archive:
    with archive.open('rclone-v1.76.0-linux-amd64/rclone') as source, open('/tools/rclone', 'xb') as target:
        target.write(source.read())
for name in ['age', 'age-keygen', 'rclone']:
    os.chmod('/tools/' + name, 0o555)
os.remove('/tmp/age.tar.gz'); os.remove('/tmp/rclone.zip')
PY
COPY --chmod=0444 plugin-release-backup.py /tools/plugin-release-backup.py
USER 501:501
ENTRYPOINT ["python3", "-B", "/tools/plugin-release-backup.py"]
