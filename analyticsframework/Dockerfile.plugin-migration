# syntax=docker/dockerfile:1.7
FROM maven:3.9-eclipse-temurin-25@sha256:93b8a14ea2f412782e4e842651273b4d903e35cc496284f178fbbe2d67d00976 AS build
WORKDIR /build

COPY pom.xml ./
COPY src/main/java ./src/main/java
RUN --mount=type=cache,target=/root/.m2 \
    mvn --batch-mode --no-transfer-progress compile dependency:copy-dependencies \
      -DincludeScope=runtime -DoutputDirectory=/build/target/migration-lib

FROM amazoncorretto:27@sha256:95d651262e5a4dd7230cf2fbf3a18c39ebb7931593b45907a48ae33a9277d4ae
WORKDIR /opt/plugin-migration

# Deliberately omit application resources and uploaded plugin JARs.
COPY --from=build /build/target/classes ./classes
COPY --from=build /build/target/migration-lib ./lib
RUN printf '%s\n' '<configuration><root level="OFF"/></configuration>' > logback.xml \
    && printf '%s\n' '#!/bin/sh' 'set -eu' 'umask 077' \
      'exec java -Dlogback.configurationFile=/opt/plugin-migration/logback.xml -cp "/opt/plugin-migration/classes:/opt/plugin-migration/lib/*" com.openlap.plugins.migration.PluginArtifactMigrationApplication "$@"' \
      > /usr/local/bin/plugin-migration \
    && chmod 0555 /usr/local/bin/plugin-migration

USER 1000:1000
ENTRYPOINT ["/usr/local/bin/plugin-migration"]
