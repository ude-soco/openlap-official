<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.openlap.plugin-backup-weekly-recovery</string>
  <key>Disabled</key><true/>
  <key>RunAtLoad</key><false/>
  <key>ProgramArguments</key>
  <array>
    <string>/CONFIGURE/VERIFIED/python3</string>
    <string>-B</string>
    <string>/CONFIGURE/INSTALLED/PUBLIC-TOOLS/scripts/collect-plugin-backup-evidence.py</string>
    <string>--config</string>
    <string>/CONFIGURE/PRIVATE/plugin-backup-evidence-collection.json</string>
    <string>--run-check</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/CONFIGURE/PRIVATE/weekly-backup-recovery.stdout.log</string>
  <key>StandardErrorPath</key><string>/CONFIGURE/PRIVATE/weekly-backup-recovery.stderr.log</string>
</dict>
</plist>
