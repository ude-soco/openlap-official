docs
compose.yaml
.gitignore
.dockerignore

# Host build output — the image rebuilds this with `mvn package` inside the
# container, so the host's target/ must never enter the build context.
target

# Workstation and uploaded JARs are deliberately excluded from the build context.
# OpenLAP does not generate these binaries. Local-mode installations need reviewed
# plugin artifacts at runtime; Git/CI supplies only the tracked placeholder folders.
# Do not package arbitrary local binaries without provenance and checksum review.
jars/analytics_techniques/*.jar
jars/visualization_methods/*.jar

# OS-generated junk that should never enter the build context.
**/.DS_Store
