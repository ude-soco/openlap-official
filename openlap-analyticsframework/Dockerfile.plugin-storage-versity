# syntax=docker/dockerfile:1.7
FROM --platform=linux/amd64 maven:3.9-eclipse-temurin-11@sha256:7bb84a451705605a47d24eb844d4d9ab03e33e131a507db76aafe25db3907f64 AS build
WORKDIR /build
COPY pom.xml ./
COPY src/main/java ./src/main/java
RUN --mount=type=cache,target=/root/.m2 \
    mvn --batch-mode --no-transfer-progress compile dependency:copy-dependencies \
      -DincludeScope=runtime -DoutputDirectory=/build/target/storage-lib

ADD --checksum=sha256:1f075c9dc92fef232f5b3c7465711ddc5e1b062b2b6df4a3bd246a4be5b35b52 \
    https://github.com/versity/versitygw/releases/download/v1.11.0/versitygw_v1.11.0_Linux_x86_64.tar.gz /tmp/versity.tar.gz
RUN mkdir /provider && tar -xzf /tmp/versity.tar.gz --strip-components=1 -C /provider \
      versitygw_v1.11.0_Linux_x86_64/versitygw versitygw_v1.11.0_Linux_x86_64/LICENSE versitygw_v1.11.0_Linux_x86_64/NOTICE \
    && /provider/versitygw --version | grep -q '1.11.0'

FROM --platform=linux/amd64 amazoncorretto:25@sha256:019e58087ba4c114c817094f70d3d522bcd13e80ce9edbba6e1c67e5700bad63
WORKDIR /opt/openlap-storage
COPY --from=build /build/target/classes ./classes
COPY --from=build /build/target/storage-lib ./lib
COPY --from=build /provider/versitygw /usr/local/bin/versitygw
COPY --from=build /provider/LICENSE /provider/NOTICE ./provider-license/
COPY --chmod=0444 plugin-recurring-export.py ./plugin-recurring-export.py
RUN command -v python3 >/dev/null \
    && printf '%s\n' '<configuration><root level="OFF"/></configuration>' > logback.xml \
    && printf '%s\n' '#!/bin/sh' 'set -eu' 'umask 077' \
      'exec java -Dlogback.configurationFile=/opt/openlap-storage/logback.xml -cp "/opt/openlap-storage/classes:/opt/openlap-storage/lib/*" com.openlap.plugins.storage.VersityStorageApplication "$@"' \
      > /usr/local/bin/openlap-storage \
    && printf '%s\n' '#!/bin/sh' 'set -eu' 'umask 077' \
      'exec java -Dlogback.configurationFile=/opt/openlap-storage/logback.xml -cp "/opt/openlap-storage/classes:/opt/openlap-storage/lib/*" com.openlap.plugins.storage.PluginObjectSnapshotApplication "$@"' \
      > /usr/local/bin/openlap-object-snapshot \
    && chmod 0555 /usr/local/bin/openlap-storage /usr/local/bin/openlap-object-snapshot /usr/local/bin/versitygw
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/openlap-storage"]
CMD ["--configure-storage"]
