.env
.env.*
# Keep the tracked environment template (negates the .env.* rule above)
!.env.example
*.csv
.settings
.classpath
.project

# VS Code: ignore local/per-user files but keep the shared project configs
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

.DS_Store
.idea/
/target/
/ObjectStore/
/bin/

# Plugin binaries are supplied separately; startup scans them for catalog metadata
# but cannot regenerate missing JARs. The folders are kept via .gitkeep.
/jars/analytics_techniques/*.jar
/jars/visualization_methods/*.jar
