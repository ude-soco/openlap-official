# syntax=docker/dockerfile:1.7
# Official Python 3.12.16; only checksum-pinned public clients enter the runtime.
FROM python@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7 AS clients
ADD --checksum=sha256:cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10 https://github.com/FiloSottile/age/releases/download/v1.3.2/age-v1.3.2-linux-amd64.tar.gz /tmp/age.tar.gz
ADD --checksum=sha256:b00f00b3266c3764413afe599d3ec316f6f43b3e0ea8a0bc1d186d2133e46df7 https://github.com/rclone/rclone/releases/download/v1.76.0/rclone-v1.76.0-linux-amd64.zip /tmp/rclone.zip
RUN python3 - <<'PYTHON'
import os, tarfile, zipfile
os.mkdir('/clients', 0o755)
with tarfile.open('/tmp/age.tar.gz') as archive:
    member = archive.getmember('age/age')
    assert member.isreg()
    with archive.extractfile(member) as source, open('/clients/age', 'xb') as target:
        target.write(source.read())
with zipfile.ZipFile('/tmp/rclone.zip') as archive:
    with archive.open('rclone-v1.76.0-linux-amd64/rclone') as source, open('/clients/rclone', 'xb') as target:
        target.write(source.read())
os.chmod('/clients/age', 0o555)
os.chmod('/clients/rclone', 0o555)
PYTHON

FROM python@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7
WORKDIR /opt/plugin-backup
COPY --from=clients /clients/ ./bin/
COPY --chmod=0444 plugin-release-backup.py plugin-backup-upload.py ./
COPY --chmod=0444 plugin-recurring-backup.py plugin-recurring-export.py plugin-recurring-record.py ./
COPY --chmod=0555 plugin-backup-upload-entrypoint.sh ./entrypoint.sh
USER 1000:1000
ENTRYPOINT ["/opt/plugin-backup/entrypoint.sh"]
CMD ["--configure-upload"]
